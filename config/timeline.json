  "dialogue": [
    {
      "id": "line_01",
      "beatId": "beat_1",
      "cameraShot": "hook_apple_drop",
      "speaker": "narrator",
      "text": "1666. What if that apple... NEVER fell?",
      "ttsText": "Sixteen sixty-six. What if that apple... never fell?",
      "windowStart": 0.18,
      "windowEnd": 2.85,
      "preferredSpeed": 1.08
    },
    {
      "id": "line_02",
      "beatId": "beat_2",
      "cameraShot": "two_shot_poke",
      "speaker": "chewton",
      "text": "Wait... why is it floating? Hello? Physics?",
      "ttsText": "Wait... why is it floating? Hello? Physics?",
      "windowStart": 3.32,
      "windowEnd": 6.22,
      "preferredSpeed": 1.08
    },
    {
      "id": "line_03",
      "beatId": "beat_3a",
      "cameraShot": "apple_reveal_whip",
      "speaker": "apple",
      "text": "Bro, you never invented gravity! I don't HAVE to drop!",
      "ttsText": "Bro, you never invented gravity! I don't HAVE to drop!",
      "windowStart": 7.62,
      "windowEnd": 10.48,
      "preferredSpeed": 1.14
    },
    {
      "id": "line_04",
      "beatId": "beat_3b",
      "cameraShot": "wig_float_chaos",
      "speaker": "chewton",
      "text": "Wait—you can TALK?!",
      "ttsText": "Wait—you can talk?!",
      "windowStart": 10.72,
      "windowEnd": 12.25,
      "preferredSpeed": 1.10
    },
    {
      "id": "line_05",
      "beatId": "beat_4",
      "cameraShot": "upside_down_montage",
      "speaker": "narrator",
      "text": "Without Chewton's gravity, the whole world forgot how to pull down!",
      "ttsText": "Without Chewton's gravity, the whole world forgot how to pull down!",
      "windowStart": 13.34,
      "windowEnd": 16.85,
      "preferredSpeed": 1.12
    },
    {
      "id": "line_06",
      "beatId": "beat_4",
      "cameraShot": "upside_down_montage",
      "speaker": "chewton",
      "text": "Wait... NO gravity means NO physics homework?!",
      "ttsText": "Wait... no gravity means no physics homework?!",
      "windowStart": 16.95,
      "windowEnd": 19.65,
      "preferredSpeed": 1.12
    },
    {
      "id": "line_07",
      "beatId": "beat_5",
      "cameraShot": "rebrand_hero_lowangle",
      "speaker": "apple",
      "text": "If you skip gravity and calculus, students worship you!",
      "ttsText": "If you skip gravity and calculus, students worship you!",
      "windowStart": 19.92,
      "windowEnd": 22.30,
      "preferredSpeed": 1.18
    },
    {
      "id": "line_08",
      "beatId": "beat_5",
      "cameraShot": "rebrand_hero_lowangle",
      "speaker": "chewton",
      "text": "Forget gravity. Call me Sir Isaac CHEWTON! Zero gravity, zero exams!",
      "ttsText": "Forget gravity, call me Sir Isaac Chewton, zero gravity, zero exams!",
      "windowStart": 22.38,
      "windowEnd": 25.72,
      "preferredSpeed": 1.24
    },
