      "id": "line_09",
      "beatId": "beat_6a",
      "cameraShot": "bonk_impact_wide",
      "speaker": "apple",
      "text": "Just kidding. Subscribe before I drop again!",
      "ttsText": "Just kidding! Subscribe before I drop again!",
